{
  "crawler": {
    "seed_url": "https://docs.kanzi.com/4.1.0/en/working-with/performance-profiling/profiling-application-code.html",
    "target_sections": [
      "Best practices",
      "Working with",
      "References"
    ],
    "output_path": "1.crawler.json",
    "max_concurrency": 30,
    "css_selector": "article"
  },
  "hierarchy": {
    "input_path": "1.crawler.json",
    "output_path": "2.structure_hierarchy.json"
  },
  "chunker": {
    "input_path": "2.structure_hierarchy.json",
    "output_path": "3.chunks.json",
    "chunk_size": 3000,
    "chunk_overlap": 300,
    "max_doc_length_threshold": 3500
  },
  "ingest": {
    "input_path": "3.chunks.json",
    "output_path": "4.ingest_pgvector.json",
    "batch_size": 64,
    "collection_name": "raptor_chunks",
    "rate_limit_delay": 3.2
  }
}