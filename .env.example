#region OpenRouter LLM & Embedding Settings
OPENROUTER_API_KEY=mock_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_TEMPERATURE=0
OPENROUTER_PROVIDER_SORT=throughput
OPENROUTER_PROVIDER_IGNORE=wafer
#endregion

#region Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=*
#endregion

#region Vector Database Settings (PGVector)
POSTGRES_HOST=pgvector
POSTGRES_PORT=5432
POSTGRES_DB=documentation_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword123
PGVECTOR_URL=postgresql+psycopg://postgres:postgrespassword123@pgvector:5432/documentation_chatbot
#endregion

#region Graph Database Settings (Neo4j)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpassword123
#endregion

#region Application Domain Settings
CHATBOT_THEME=Kanzi QA Chatbot
#endregion

#region LangSmith Observability Settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=mock_key
LANGSMITH_PROJECT=Enterprise-RAG-Engine
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
#endregion