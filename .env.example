#region OpenRouter LLM & Embedding Settings
OPENROUTER_API_KEY=mock_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_JEV_MODEL=typesafe/jev-latest
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_TEMPERATURE=0
OPENROUTER_PROVIDER_SORT=throughput
OPENROUTER_PROVIDER_IGNORE=wafer
#endregion

#region Local Ollama Settings (HyDE Acceleration)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b
#endregion

#region Vector Database Settings (PGVector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword123
POSTGRES_DB=documentation_chatbot
PGVECTOR_URL=postgresql+psycopg://postgres:postgrespassword123@localhost:5432/documentation_chatbot
PGVECTOR_COLLECTION_NAME=raptor_chunks
#endregion

#region Application Domain Settings
CHATBOT_THEME=Kanzi QA Chatbot
#endregion

#region LangSmith Observability & Logging Settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=mock_key
LANGSMITH_PROJECT=Enterprise-RAG-Engine
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LOG_LEVEL=WARNING
#endregion