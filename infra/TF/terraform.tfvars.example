# Example Terraform Variables Configuration File
# Copy to 'terraform.tfvars' and replace placeholders with real values.

#region Cluster Settings
use_aws_eks        = false
aws_region         = "us-east-1"
eks_cluster_name   = "theme-based-rag-eks"
kubeconfig_path    = "~/.kube/config"
namespace          = "documentation-chatbot"
#endregion

#region LLM Configuration
gemini_api_key     = "YOUR_GEMINI_API_KEY_HERE"
gemini_model       = "gemini-3.6-flash"
gemini_embed_model = "gemini-embedding-004"
chatbot_theme      = "Fintech SaaS platform"
#endregion

#region Observability Settings
langsmith_tracing  = "true"
langsmith_api_key  = "YOUR_LANGSMITH_API_KEY_HERE"
langsmith_project  = "pr-virtual-cork-53"
#endregion

#region Deployment Scaling
backend_replicas   = 2
#endregion

#region Container Images
backend_image      = "theme-based-rag-backend:latest"
pgvector_image     = "pgvector/pgvector:pg16"
neo4j_image        = "neo4j:5.20.0"
#endregion

#region Database Credentials
postgres_db        = "documentation_chatbot"
postgres_user      = "postgres"
postgres_password  = "YOUR_POSTGRES_PASSWORD_HERE"
neo4j_username     = "neo4j"
neo4j_password     = "YOUR_NEO4J_PASSWORD_HERE"
#endregion

#region Service Endpoints
# Note: In Kubernetes deployment, these are constructed automatically via Service DNS if empty
postgres_host      = ""
postgres_port      = 5432
neo4j_uri          = "bolt://localhost:7687"
#endregion

